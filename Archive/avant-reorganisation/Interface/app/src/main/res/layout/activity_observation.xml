<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/observationRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/couleur_fond">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- En-tête : titre + déconnexion -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/titre_observation"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/couleur_principale" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_quitter"
                android:textColor="@color/couleur_texte_secondaire" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/couleur_texte_secondaire"
            tools:text="Bienvenue, personnel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/mode_consultation"
            android:textSize="12sp"
            android:textStyle="italic"
            android:textColor="@color/couleur_texte_secondaire" />

        <!-- Carte source d'alimentation -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/couleur_carte"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_source"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/couleur_texte" />

                <TextView
                    android:id="@+id/tvSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Ligne fixe (JIRAMA)" />

                <TextView
                    android:id="@+id/tvSourceDepuis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/couleur_texte_secondaire"
                    tools:text="Depuis 09/10/2026 14:32 — il y a 2 min" />

                <TextView
                    android:id="@+id/tvBascule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:textColor="@color/couleur_accent"
                    android:visibility="gone"
                    tools:text="Bascule vers le groupe dans 43 min"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvDernierEnvoi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:textColor="@color/couleur_texte_secondaire"
                    tools:text="Source : capteurs réels" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte ligne fixe JIRAMA (info principale) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/couleur_carte"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_ligne"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/couleur_texte" />

                <TextView
                    android:id="@+id/tvLigneStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="SOUS TENSION" />

                <TextView
                    android:id="@+id/tvLigneDepuis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/couleur_texte_secondaire"
                    tools:text="Depuis 09/10/2026 14:32" />

                <TextView
                    android:id="@+id/tvProchaineCoupure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="13sp"
                    android:textColor="@color/couleur_texte_secondaire"
                    tools:text="Prochaine coupure programmée (JIRAMA) : 15/10/2026" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte carburant (information uniquement) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/couleur_carte"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_carburant"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/couleur_texte" />

                <TextView
                    android:id="@+id/tvCarburant"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="63 %" />

                <TextView
                    android:id="@+id/tvCarburantDepuis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/couleur_texte_secondaire"
                    tools:text="Mesuré le 09/10/2026 14:30" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte alertes actives (lecture seule) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/couleur_carte"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_alertes"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/couleur_texte" />

                <TextView
                    android:id="@+id/tvAlertesVide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:textColor="@color/couleur_texte_secondaire"
                    android:text="@string/aucune_alerte" />

                <LinearLayout
                    android:id="@+id/llAlertes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Historique ligne fixe (lecture seule) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="@color/couleur_carte"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_historique"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/couleur_texte" />

                <LinearLayout
                    android:id="@+id/llHistorique"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Timeline des sources (lecture seule) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/couleur_carte"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_timeline"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/couleur_texte" />

                <TextView
                    android:id="@+id/tvTimelineVide"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textStyle="italic"
                    android:textColor="@color/couleur_texte_secondaire"
                    android:text="@string/aucune_donnee" />

                <LinearLayout
                    android:id="@+id/llTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
