<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/commandeRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/couleur_fond">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- En-tête : titre + déconnexion -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/titre_commande"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/couleur_principale" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_quitter"
                android:textColor="@color/couleur_texte_secondaire" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWelcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="@color/couleur_texte_secondaire"
            tools:text="Bienvenue, admin" />

        <!-- Carte source d'alimentation (état réel) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="@color/couleur_carte"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_source"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/couleur_texte" />

                <TextView
                    android:id="@+id/tvSource"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    tools:text="Ligne fixe (JIRAMA)" />

                <TextView
                    android:id="@+id/tvSourceDepuis"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textSize="13sp"
                    android:textColor="@color/couleur_texte_secondaire"
                    tools:text="Depuis 09/10/2026 14:32" />

                <TextView
                    android:id="@+id/tvDernierEnvoi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:textColor="@color/couleur_texte_secondaire"
                    tools:text="Source : capteurs réels" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bouton de commande (démo seulement) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnActionGroupe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:padding="14dp"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/couleur_texte_bouton"
            app:cornerRadius="8dp"
            tools:text="DÉMARRER LE GROUPE"
            tools:backgroundTint="@color/couleur_succes" />

        <!-- Note : pourquoi le bouton est désactivé en mode serveur -->
        <TextView
            android:id="@+id/tvNoteCommande"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="12sp"
            android:textStyle="italic"
            android:gravity="center"
            android:textColor="@color/couleur_texte_secondaire"
            android:text="@string/note_commande_serveur"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Historique -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="8dp"
            app:cardBackgroundColor="@color/couleur_carte"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/section_historique"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/couleur_texte" />

                <LinearLayout
                    android:id="@+id/llHistorique"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
