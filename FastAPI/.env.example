# Stella FastAPI — configuration LOCALE DE DÉVELOPPEMENT
# Copier ce fichier vers .env dans le dossier FastAPI :
#   cp .env.example .env
# Ne jamais committer le fichier .env ni y mettre de vrais secrets.
#
# Ce fichier est destiné à l'exécution locale de FastAPI depuis le PC hôte.
# Dans un conteneur Docker, "localhost" désigne le conteneur : remplacez
# DATABASE_URL par l'adresse du service PostgreSQL joignable depuis Docker.
# En production, utilisez APP_ENV=production, un JWT_SECRET_KEY aléatoire
# (>= 32 caractères), SIMULATOR_ENABLED=false et SEED_DEV_DATA=false.

APP_NAME=Stella API
APP_ENV=development
API_V1_PREFIX=/api/v1

# Base de données PostgreSQL (depuis l'hôte local).
# Développement rapide sans PostgreSQL possible : sqlite:///./stella_dev.db
DATABASE_URL=postgresql+psycopg://stella_app:change-me@localhost:5432/stella

# Valeur volontairement reconnue comme placeholder : le backend refusera
# de démarrer en production si cette valeur n'est pas remplacée.
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-running
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Liste séparée par des virgules des origines autorisées.
CORS_ORIGINS=http://localhost:8080

# Simulateur électronique : uniquement pour le développement et les tests.
SIMULATOR_ENABLED=true
SIMULATOR_DEVICE_ID=ge-ctrl-01

# Heartbeat / disponibilité du contrôleur.
DEVICE_HEARTBEAT_INTERVAL_SECONDS=30
DEVICE_OFFLINE_AFTER_SECONDS=90

# Livraison et expiration des commandes.
DEVICE_COMMAND_POLL_SECONDS=4
COMMAND_DEFAULT_TTL_SECONDS=60
COMMAND_LEASE_SECONDS=15
COMMANDS_REQUIRE_ONLINE=true

# Comptes et appareil de démonstration — développement uniquement.
# Changez ces valeurs même pour une démo partagée.
SEED_DEV_DATA=true
SEED_ADMIN_PASSWORD=admin-dev-only
SEED_OPERATEUR_PASSWORD=operateur-dev-only
SEED_LECTURE_PASSWORD=lecture-dev-only
SEED_DEVICE_KEY=dev-device-key-ge-ctrl-01
